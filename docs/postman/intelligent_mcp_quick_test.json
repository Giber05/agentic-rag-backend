    "event": [
        {
            "listen": "prerequest",
            "script": {
                "exec": [
                    "// Set timestamp for tracking request times",
                    "pm.globals.set('requestStart', Date.now());"
                ],
                "type": "text/javascript"
            }
        },
        {
            "listen": "test",
            "script": {
                "exec": [
                    "// Basic response validation",
                    "pm.test('Response is successful', function () {",
                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "",
                    "// Response time tracking",
                    "const responseTime = pm.response.responseTime;",
                    "pm.test('Response time is acceptable (< 30s)', function () {",
                    "    pm.expect(responseTime).to.be.below(30000);",
                    "});",
                    "",
                    "// Log key metrics for intelligent MCP responses",
                    "if (pm.response.json()) {",
                    "    const response = pm.response.json();",
                    "    ",
                    "    // Log intelligent MCP specific metrics",
                    "    if (response.metadata && response.metadata.total_operations) {",
                    "        console.log(`🧠 Operations: ${response.metadata.total_operations}, Duration: ${response.metadata.chain_duration}s, Intent: ${response.metadata.intent}`);",
                    "    }",
                    "    ",
                    "    // Log health check results",
                    "    if (response.healthy !== undefined) {",
                    "        console.log(`🔥 Health: ${response.healthy ? 'HEALTHY' : 'UNHEALTHY'}`);",
                    "    }",
                    "    ",
                    "    // Auto-extract auth token if present",
                    "    if (response.access_token) {",
                    "        pm.collectionVariables.set('authToken', response.access_token);",
                    "    }",
                    "}",
                    "",
                    "// Track processing time",
                    "const startTime = pm.globals.get('requestStart');",
                    "if (startTime) {",
                    "    const totalTime = Date.now() - parseInt(startTime);",
                    "    console.log(`⏱️ Total request time: ${totalTime}ms`);",
                    "}"
                ],
                "type": "text/javascript"
            }
        }
    ]
}